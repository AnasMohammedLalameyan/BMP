# Copy to .env and fill in. Database and web-application settings are documented in the project guide;
# only the AI assistant keys are listed here. Never commit .env.

# --- AI assistant (Groq) ---
AI_ENABLED=false
AI_PROVIDER=groq
GROQ_API_KEY=
AI_MODEL_EXTRACT=openai/gpt-oss-120b
AI_MODEL_CHAT=openai/gpt-oss-120b
AI_MODEL_FAST=openai/gpt-oss-20b
AI_BASE_URL=
AI_REQUEST_TIMEOUT_S=60
AI_MAX_CALLS_PER_MINUTE=20
AI_MAX_INPUT_TOKENS_PER_CALL=3000
AI_DATA_MODE=dummy
AI_ZDR_CONFIRMED=false
AI_OUTSIDE_INDIA_APPROVED=false
AI_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
AI_INDEX_DIR=data/ai_index
AI_LIBRARY_DIR=data/library
AI_SMTP_HOST=localhost
AI_SMTP_PORT=1025
AI_SMTP_FROM=
AI_SMTP_SANDBOX=true
# TYPESENSE_HOST=
# TYPESENSE_PORT=
# TYPESENSE_API_KEY=
# Models and limits change: check Groq's current model list and your account limits before enabling.
